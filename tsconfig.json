{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "baseUrl": ".",
    "paths": {
      "@shared/*": ["src/shared/*"],
      "@food/*": ["src/food/*"],
      "@weight/*": ["src/weight/*"],
      "@today/*": ["src/today/*"],
      "@journey/*": ["src/journey/*"],
