{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "baseUrl": ".",
    "paths": {
      "@app/*": ["src/app/*"],
      "@shared/*": ["src/shared/*"],
      "@food/*": ["src/food/*"],
      "@weight/*": ["src/weight/*"],
      "@today/*": ["src/today/*"],
      "@journey/*": ["src/journey/*"],
      "@trends/*": ["src/trends/*"],
      "@settings/*": ["src/settings/*"],
      "@medication/*": ["src/medication/*"],
      "@water/*": ["src/water/*"],
      "@mood/*": ["src/mood/*"]
    }
  }
}
