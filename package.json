{
  "name": "tern",
  "version": "0.1.2",
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "jest",
    "test:watch": "jest --watch"
  },
  "dependencies": {
    "@expo-google-fonts/fraunces": "^0.4.1",
    "@expo-google-fonts/manrope": "^0.4.3",
    "@expo/vector-icons": "^15.0.3",
    "@kingstinct/react-native-healthkit": "16.2.0",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/bottom-tabs": "^7.22.0",
    "@react-navigation/elements": "^2.9.45",
    "@react-navigation/native": "^7.5.2",
    "@react-navigation/native-stack": "^7.21.1",
    "@supabase/supabase-js": "^2.119.0",
    "expo": "^58.0.26",
    "expo-asset": "~58.0.21",
    "expo-build-properties": "~58.0.12",
    "expo-camera": "~58.0.14",
    "expo-constants": "~58.0.16",
    "expo-dev-client": "~58.0.21",
    "expo-document-picker": "~58.0.5",
    "expo-file-system": "~58.0.14",
    "expo-font": "~58.0.12",
    "expo-haptics": "~58.0.8",
    "expo-linear-gradient": "~58.0.4",
    "expo-linking": "~58.0.17",
    "expo-notifications": "~58.1.9",
    "expo-sharing": "~58.0.23",
    "expo-splash-screen": "~58.0.14",
    "expo-sqlite": "~58.0.18",
    "expo-status-bar": "~58.0.5",
    "react": "19.3.0",
    "react-native": "0.88.1",
    "react-native-health-connect": "^4.1.3",
    "react-native-nitro-modules": "^0.37.2",
    "react-native-purchases": "^10.15.0",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-svg": "15.16.0",
    "react-native-url-polyfill": "^4.0.0"
  },
  "devDependencies": {
    "@babel/core": "^7.29.13",
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "30.0.0",
    "@types/node": "^24.19.2",
    "@types/react": "~19.3.0",
    "@types/sql.js": "^1.4.11",
    "babel-plugin-module-resolver": "^5.0.3",
    "babel-preset-expo": "~58.0.0",
    "eas-cli": "25.3.0",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~58.0.4",
    "jest": "~30.5.2",
    "jest-expo": "~58.0.15",
    "react-test-renderer": "^19.3.0",
    "sql.js": "^1.16.0",
    "typescript": "~6.0.3"
  },
  "private": true,
  "license": "UNLICENSED",
  "jest": {
    "preset": "jest-expo",
    "setupFiles": [
      "<rootDir>/jest.setup.js"
    ],
    "testTimeout": 15000,
    "testPathIgnorePatterns": [
      "/node_modules/",
      "<rootDir>/.claude/"
    ],
    "modulePathIgnorePatterns": [
      "<rootDir>/.claude/"
    ],
    "transformIgnorePatterns": [
      "node_modules/(?!((jest-)?react-native|@react-native(-community)?)|expo(nent)?|@expo(nent)?/.*|@expo-google-fonts/.*|react-navigation|@react-navigation/.*|@unimodules/.*|unimodules|sentry-expo|native-base|react-native-svg)"
    ],
    "collectCoverageFrom": [
      "src/**/*.{ts,tsx}",
      "!src/**/*.test.{ts,tsx}"
    ]
  }
}
