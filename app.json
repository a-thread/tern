{
  "expo": {
    "name": "Tern",
    "slug": "tern",
    "scheme": "tern",
    "version": "0.1.1",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#F5F3EE"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.purlieus.tern",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.purlieus.tern",
      "allowBackup": true,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#F5F3EE"
      },
      "permissions": [
        "android.permission.health.READ_STEPS",
        "android.permission.health.READ_EXERCISE",
        "android.permission.CAMERA"
      ]
    },
    "plugins": [
      "expo-font",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#26262B"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Tern uses the camera to scan food barcodes. Nothing is recorded or saved.",
          "recordAudioAndroid": false
        }
      ],
      [
        "@kingstinct/react-native-healthkit",
        {
          "NSHealthShareUsageDescription": "Tern reads your step counts and workouts from Apple Health to show your daily movement and streak. Nothing is shared or sold.",
          "NSHealthUpdateUsageDescription": false,
          "background": false
        }
      ],
      "react-native-health-connect",
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 36,
            "targetSdkVersion": 36,
            "minSdkVersion": 26
          }
        }
      ],
      "expo-sqlite",
      "expo-asset"
    ],
    "extra": {
      "eas": {
        "projectId": "5a0739df-fa83-452d-8c31-92cd473ffa80"
      }
    },
    "owner": "purlieus-systems",
    "newArchEnabled": false
  }
}
