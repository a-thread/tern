# Copy to .env (gitignored). Leave both blank to run on local mock data.
# The anon key is designed to be public; row-level security protects the data.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Set to 1 only in a dev build (Expo Go can't load them): reads steps and workouts from Health
# Connect on Android and Apple Health on iPhone. EXPO_PUBLIC_HEALTH_CONNECT still works as an old name.
EXPO_PUBLIC_HEALTH=

# Set to 1 only locally, for demo screenshots: sample steps in place of the health app's,
# signed in or not. They earn the signed-in account real waypoints, so never set it in EAS.
EXPO_PUBLIC_SAMPLE_STEPS=

# Free key from https://fdc.nal.usda.gov/api-key-signup.html (emailed instantly).
# Enables everyday-food search with household portions. Blank = Open Food Facts only.
# Add it as an EAS environment variable too, since .env is not used by EAS builds.
EXPO_PUBLIC_USDA_API_KEY=

# RevenueCat public SDK keys (Project settings > API keys), for Tern Plus. Public by design.
# Dev build only (Expo Go can't load the native module). Blank = buying is simulated and free.
# Add them as EAS environment variables too.
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
