# Copy to .env (gitignored). Leave both blank to run on local mock data.
# The anon key is designed to be public; row-level security protects the data.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Set to 1 only in a dev build with react-native-health-connect installed.
EXPO_PUBLIC_HEALTH_CONNECT=
